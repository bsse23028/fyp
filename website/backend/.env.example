# KidBuddy WEBSITE backend (the web gateway). Copy this file to ".env" and fill it in.
# (.env is private: never commit it.)

# ----- this server -----
PORT=5050
# development | production   (production = Secure cookies + serves the built frontend)
NODE_ENV=development

# ----- the shared KidBuddy API (the same backend the mobile app uses: fyp/backend) -----
# Every account, child profile and progress record lives there, so the website and the
# phone app always see the same data.
KIDBUDDY_API_URL=http://127.0.0.1:4000
# Give up on the shared API after this many milliseconds.
UPSTREAM_TIMEOUT_MS=15000

# ----- browsers allowed to call this server (comma separated) -----
# In development the Vite dev server proxies /api to this server, so the default is enough.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5050

# ----- cookies -----
# Name of the httpOnly cookie that holds the login. Leave as it is unless two sites share a domain.
SESSION_COOKIE_NAME=kb_session
# How long the browser keeps the login cookie (days). The API's own token (JWT_EXPIRES_IN in
# fyp/backend/.env, default 7 days) still decides when the login really ends.
SESSION_DAYS=7
# true = cookies only travel over HTTPS. Always true in production behind HTTPS.
COOKIE_SECURE=false

# ----- serving the website -----
# Folder of the built frontend (npm run build in website/frontend). Served when it exists.
FRONTEND_DIST=../frontend/dist
# Set to 1 when running behind a reverse proxy (nginx, Render, Heroku ...) so rate limits see the real IP.
TRUST_PROXY=0
