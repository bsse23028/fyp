# KidBuddy WEBSITE frontend. Copy to ".env" only if you need to change something.
# Where the Vite dev server sends /api and /web-api (the website backend in website/backend).
VITE_BACKEND_URL=http://localhost:5050
# true = the 6-digit codes are printed in the shared API's terminal (EMAIL_MODE=console),
# so the code screens show a small reminder. Set to false when real emails are sent.
VITE_DEMO_CODES=false
