# Copy this file to ".env" and fill in your own values.
# (.env is private: never commit it to git.)

# ----- Server -----
PORT=4000

# ----- Database (XAMPP default: user "root" with an empty password) -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kidbuddy

# The automated tests build and use THIS database, never DB_NAME.
# It must end with "_test".
TEST_DB_NAME=kidbuddy_test

# ----- Login tokens (JWT) -----
# A long random string. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ----- Email (the 6-digit codes) -----
# console = print the email in the server terminal (for development on your own computer)
# smtp    = really send it with the SMTP settings below
EMAIL_MODE=console
EMAIL_FROM=KidBuddy <no-reply@kidbuddy.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
