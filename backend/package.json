{
  "name": "kidbuddy-backend",
  "version": "1.0.0",
  "description": "REST API for the KidBuddy app (Node.js + Express + MySQL/MariaDB).",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node database/migrate.js",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./tests/setup/testEnv.js"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup/closeDatabase.js"
    ],
    "globalSetup": "./tests/setup/globalSetup.js",
    "testTimeout": 30000
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
